{
  "manifest_version": 3,
  "name": "MintHRM Attendance Automation System",
  "short_name": "MintHRM AAS",
  "version": "2.1.0",
  "description": "Fill missing MintHRM In/Out times with your chosen reason and submit every day, page by page, in one click.",
  "homepage_url": "https://github.com/AshenWijesingha/MintHRM-Attendance-Automation-System",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MintHRM Attendance Automation System",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.minthrm.com/*dailyattendance/MyAttendance*",
        "https://*.minthrm.com/*dailyattendance/myattendance*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
